# no pkg-config for android builds on windows, so pkg_check_modules() gets what deps.py built. gtk & co are empty
set(PKG_CONFIG_FOUND TRUE)
set(PKG_CONFIG_EXECUTABLE "blox7-win-pkg-config")
set(BLOX7_WIN_DEPS "${BLOX7_WIN_DEPS_PREFIX}")

# name -> "include dirs|libraries"
set(_mt_pkg_yaml-0.1 "${BLOX7_WIN_DEPS}/include|${BLOX7_WIN_DEPS}/lib/libyaml.a")
set(_mt_pkg_minizip "${BLOX7_WIN_DEPS}/include/minizip;${BLOX7_WIN_DEPS}/include|${BLOX7_WIN_DEPS}/lib/libminizip.a;${BLOX7_WIN_DEPS}/lib/libz.so")
set(_mt_pkg_capstone "${BLOX7_WIN_DEPS}/include;${BLOX7_WIN_DEPS}/include/capstone|${BLOX7_WIN_DEPS}/lib/libcapstone.a")
set(_mt_pkg_libelf "${BLOX7_WIN_DEPS}/include|${BLOX7_WIN_DEPS}/lib/libelf.a")
set(_mt_pkg_libutf8proc "${BLOX7_WIN_DEPS}/include|${BLOX7_WIN_DEPS}/lib/libutf8proc.a")
set(_mt_pkg_fontconfig "|")
set(_mt_pkg_gio-2.0 "|")
set(_mt_pkg_gtk4 "|")
set(_mt_pkg_libadwaita-1 "|")
set(_mt_pkg_webkitgtk-6.0 "|")
set(_mt_pkg_libplacebo "|")
set(_mt_pkg_libpng "${BLOX7_WIN_DEPS}/include|${BLOX7_WIN_DEPS}/lib/libpng16.a;${BLOX7_WIN_DEPS}/lib/libz.so")
set(_mt_missing_libsecret-1 TRUE)

macro(pkg_check_modules prefix)
  set(_mt_modules "")
  set(_mt_imported FALSE)
  foreach(_mt_arg ${ARGN})
    if(_mt_arg STREQUAL "IMPORTED_TARGET")
      set(_mt_imported TRUE)
    elseif(NOT _mt_arg MATCHES "^(REQUIRED|QUIET|NO_CMAKE_PATH|NO_CMAKE_ENVIRONMENT_PATH|GLOBAL)$")
      string(REGEX REPLACE "[<>=].*$" "" _mt_name "${_mt_arg}")
      list(APPEND _mt_modules "${_mt_name}")
    endif()
  endforeach()
  set(${prefix}_FOUND TRUE)
  set(${prefix}_INCLUDE_DIRS "")
  set(${prefix}_LIBRARIES "")
  foreach(_mt_module ${_mt_modules})
    if(DEFINED _mt_missing_${_mt_module})
      set(${prefix}_FOUND FALSE)
    elseif(DEFINED _mt_pkg_${_mt_module})
      string(REPLACE "|" ";" _mt_parts "${_mt_pkg_${_mt_module}}")
      list(LENGTH _mt_parts _mt_n)
      string(FIND "${_mt_pkg_${_mt_module}}" "|" _mt_bar)
      string(SUBSTRING "${_mt_pkg_${_mt_module}}" 0 ${_mt_bar} _mt_inc)
      math(EXPR _mt_after "${_mt_bar} + 1")
      string(SUBSTRING "${_mt_pkg_${_mt_module}}" ${_mt_after} -1 _mt_libs)
      list(APPEND ${prefix}_INCLUDE_DIRS ${_mt_inc})
      list(APPEND ${prefix}_LIBRARIES ${_mt_libs})
    else()
      message(FATAL_ERROR "Windows port: no package ${_mt_module}")
    endif()
  endforeach()
  if(${prefix}_FOUND AND _mt_imported AND NOT TARGET PkgConfig::${prefix})
    add_library(PkgConfig::${prefix} INTERFACE IMPORTED GLOBAL)
    set_target_properties(PkgConfig::${prefix} PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${${prefix}_INCLUDE_DIRS}"
      INTERFACE_LINK_LIBRARIES "${${prefix}_LIBRARIES}")
  endif()
endmacro()
